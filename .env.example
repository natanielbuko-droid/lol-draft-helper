# Skopiuj ten plik jako .env i uzupełnij. Plik .env NIE trafia do gita.

# Klucz z https://developer.riotgames.com (Development API Key ważny 24 h)
RIOT_API_KEY=

# Serwer, z którego zbierać mecze: euw1 (EU West), eun1 (EU Nordic & East), na1, kr...
RIOT_PLATFORM=eun1

# Opcjonalnie: automatyczny crawl w tle co N godzin podczas `npm run dev`
AUTO_CRAWL_HOURS=0
